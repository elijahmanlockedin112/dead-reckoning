# You don't need this file. Just run the server and paste your key into the
# page — tick "remember on this machine" and it writes .env for you.
#
# This is here for the case where you'd rather set things up by hand.
# Free keys: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Leave unset and the server asks the API which models your key can
# use, then picks the best available Flash model on its own.
# GEMINI_MODEL=gemini-flash-latest

# Optional. Defaults to 4700.
# PORT=4700
